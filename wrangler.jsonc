{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "send-it",
  "account_id": "72dfdb7692ec6241dc5476af2edf879b",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER_STORE",
        "class_name": "OwnerStore",
        "script_name": "send-it-store"
      }
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM": "broad-wave-65e1",
    "ACCESS_AUD": "71dee65aa3809f6b36311bd444cea98bf9595c37d0425c856fa739359b15ba4c",
    // Signed-in emails allowed to download beta sign-ups at /api/signups.
    "ADMIN_EMAILS": "contact@superlogicai.com"
  },
  "routes": [
    {
      "pattern": "sendit.day",
      "custom_domain": true
    },
    {
      "pattern": "app.sendit.day",
      "custom_domain": true
    }
  ]
}
