{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "send-it",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER_STORE",
        "class_name": "OwnerStore",
        "script_name": "send-it-store"
      }
    ]
  },
  "workers_dev": false,
  "preview_urls": false
}
