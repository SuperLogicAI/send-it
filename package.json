{
  "name": "send-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:store": "wrangler dev -c store/wrangler.jsonc --port 8799",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "node scripts/check.ts",
    "check:workers": "node scripts/check-workers.ts"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.1.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.2.1"
  },
  "overrides": {
    "ignore@^7.0.0": "7.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/node": "26.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  }
}
